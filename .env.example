# .env.example — copy to .env and fill in values
# NEVER commit .env to git

DATABASE_URL=./emseed.db

# Groq — 2 keys, round-robin rotation (100 req/hr, 10 req/min each)
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_RPH=100
GROQ_RPM=10

# Sarvam AI — 2 keys, round-robin rotation (50 req/hr, 5 req/min each)
SARVAM_API_KEY_1=sk_...
SARVAM_API_KEY_2=sk_...
SARVAM_RPH=50
SARVAM_RPM=5

# Gemini — last resort only, SQLite preferred (15 req/min each)
GEMINI_API_KEY_1=AI...
GEMINI_API_KEY_2=AI...
GEMINI_RPM=15
GEMINI_RPH=1000

# Demo mode toggle for frontend
REACT_APP_DEMO_MODE=true
